{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": false },
      "env": { "EXPO_PUBLIC_DATA_API_URL": "http://localhost:8787" }
    },
    "preview": {
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_DATA_API_URL": "https://data.coinline.app" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_DATA_API_URL": "https://data.coinline.app" }
    }
  },
  "submit": { "production": {} }
}
