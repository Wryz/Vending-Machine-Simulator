{
  "expo": {
    "name": "Coinline",
    "slug": "coinline",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "coinline",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.coinline.vending",
      "buildNumber": "2",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Coinline uses your approximate location once, to start your business in the closest city. It is never stored.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleLocalizations": ["en", "es", "fr", "de", "ja", "ko", "zh-Hans", "pt-BR"],
        "CFBundleDevelopmentRegion": "en"
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1"]
          }
        ]
      },
      "appleTeamId": "BXGQNYDRM6"
    },
    "android": {
      "package": "app.coinline.vending",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FF6B2C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": ["ACCESS_COARSE_LOCATION"],
      "blockedPermissions": ["ACCESS_FINE_LOCATION", "ACCESS_BACKGROUND_LOCATION"],
      "predictiveBackGestureEnabled": false
    },
    "locales": {
      "en": "./assets/i18n/en.json",
      "es": "./assets/i18n/es.json",
      "fr": "./assets/i18n/fr.json",
      "de": "./assets/i18n/de.json",
      "ja": "./assets/i18n/ja.json",
      "ko": "./assets/i18n/ko.json",
      "zh-Hans": "./assets/i18n/zh-Hans.json",
      "pt-BR": "./assets/i18n/pt-BR.json"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FF6B2C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 170
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-asset",
      "expo-audio",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Coinline uses your approximate location once, to start your business in the closest city. It is never stored.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "locationFullAccuracyPermission": false,
          "motionUsagePermission": false,
          "isIosReducedAccuracyByDefault": true,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2E7D5B"
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "Only if you turn on personalized ads in Settings: lets ad partners show ads that fit you. Coinline works the same either way."
        }
      ],
      "expo-font",
      "expo-sharing",
      [
        "react-native-google-mobile-ads",
        {
          "iosAppId": "ca-app-pub-3538177621347149~7872103117",
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "userTrackingUsageDescription": "Only if you turn on personalized ads in Settings: lets ad partners show ads that fit you. Coinline works the same either way."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {}
    }
  }
}
